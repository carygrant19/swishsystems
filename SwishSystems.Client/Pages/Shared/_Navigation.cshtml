@{
    string activePage = ViewData["ActivePage"]?.ToString()?.ToLower() ?? "home";

    string GetActiveAttribute(string pageName)
    {
        return activePage == pageName.ToLower() ? "active" : "";
    }
}

<div class="nav-container">
    <nav>
        <ul>
            <li>
                <a class="nav-link @GetActiveAttribute("home")" href="/" onclick="showPage('home')">Home</a>
            </li>
            <li>
                <a class="nav-link @GetActiveAttribute("league")" href="/League" onclick="showPage('league')">About the League</a>
            </li>
            <li>
                <a class="nav-link @GetActiveAttribute("divisions")" href="/Division" onclick="showPage('divisions')">Divisions</a>
            </li>
          @*   <li>
                <a class="nav-link @GetActiveAttribute("seasons")" href="/Seasons" onclick="showPage('seasons')" id="nav-seasons">Seasons</a>
            </li>
            <li>
                <a class="nav-link @GetActiveAttribute("schedule")" href="/Schedule" onclick="showPage('schedule')">Schedule</a>
            </li>
            <li>
                <a class="nav-link @GetActiveAttribute("summary")" href="/Summary" onclick="showPage('summary')">Summary</a>
            </li>
            <li>
                <a class="nav-link @GetActiveAttribute("boxscore")" href="/BoxScore" onclick="showPage('boxscore')">Box Score</a>
            </li> *@
        </ul>
    </nav>
    <button class="theme-btn" id="theme-toggle" onclick="toggleTheme()">☀️ Light</button>
</div>