<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Court Vision - @ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <div class="logo" onclick="showPage('home')">SWISH<span style="color: var(--accent-orange)">SYSTEMS</span></div>
        <partial name="_Navigation" />
    </header>

    <div class="main-wrapper">
    @RenderBody()
    </div>
    <footer>
        Powered by <span>SWISH SYSTEMS</span>
    </footer>
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
