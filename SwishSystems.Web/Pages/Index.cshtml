<section id="contact">
    <h2 class="section-title">Ready to Get Started?</h2>

    <div class="contact-container">
        <div class="contact-info">
            <h3 style="margin-bottom: 1.5rem;">Let's Talk</h3>
            <p style="margin-bottom: 2rem;">Whether you want to demo our basketball platform or brainstorm a custom app for your business, our team is here to help.</p>

            <div style="margin-bottom: 1rem;">
                <strong>Email:</strong> hello@swishsystems.com
            </div>
            <div style="margin-bottom: 1rem;">
                <strong>Phone:</strong> +63 123 456 7890
            </div>
            <div style="margin-bottom: 1rem;">
                <strong>Location:</strong> Metro Manila, Philippines
            </div>
        </div>

        <div class="contact-form">
            <form action="#" onsubmit="event.preventDefault(); alert('Form submitted!');">
                <input type="text" placeholder="Your Name" required>
                <input type="email" placeholder="Your Email" required>
                <select required>
                    <option value="" disabled selected>What are you interested in?</option>
                    <option value="basketball">Court Vision League System</option>
                    <option value="custom">Custom Software Development</option>
                    <option value="career">Career / Job Application</option>
                    <option value="other">Other</option>
                </select>
                <textarea placeholder="Tell us about your project or league..." required></textarea>
                <button type="submit" class="btn btn-primary">Send Message</button>
            </form>
        </div>
    </div>
</section>